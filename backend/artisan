#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;

define('LARAVEL_START', microtime(true));

// Register Composer Autoloader if available
if (file_exists(__DIR__ . '/vendor/autoload.php')) {
    require __DIR__ . '/vendor/autoload.php';
}

// Check if PHP CLI server command (artisan serve emulation)
if (isset($argv[1]) && $argv[1] === 'serve') {
    $host = '127.0.0.1';
    $port = 8000;
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--host=')) {
            $host = substr($arg, 7);
        }
        if (str_starts_with($arg, '--port=')) {
            $port = (int)substr($arg, 7);
        }
    }

    echo "INFO  Server running on [http://{$host}:{$port}].\n";
    echo "Press Ctrl+C to stop the server\n\n";

    passthru(PHP_BINARY . " -S {$host}:{$port} -t public");
    exit(0);
}

// Standard Laravel 11 bootstrap
if (file_exists(__DIR__ . '/bootstrap/app.php') && file_exists(__DIR__ . '/vendor/autoload.php')) {
    (require_once __DIR__ . '/bootstrap/app.php')
        ->handleCommand(new Symfony\Component\Console\Input\ArgvInput);
} else {
    echo "AI Conversation & Sales Suite - Laravel 11 Engine\n";
    echo "To run full artisan commands, ensure 'composer install' has been executed.\n";
}
